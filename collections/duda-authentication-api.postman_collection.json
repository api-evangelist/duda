          "name": "Get SSO Link",
          "request": {
            "name": "Get SSO Link",
            "description": {
              "content": "Generates a link that automatically logs an Account into Duda.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                "sso",
                ":account_name",
                "link"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "site_name",
                  "value": "<string>",
                  "description": "A valid site name of an existing website."
                },
                {
                  "disabled": false,
                  "key": "target",
                  "value": "<string>",
                  "description": "Target destination within Duda editor."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_name",
                  "description": "(Required) The account name is a unique reference to the account."
                }
              ]
            },
