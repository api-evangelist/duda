{
  "opencollection": "1.0.0",
  "info": {
    "name": "Duda Partner Accounts Collections API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Collections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Collection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.duda.co/api/sites/multiscreen/:site_name/collection",
            "params": [
              {
                "name": "site_name",
                "value": "",
                "type": "path",
                "description": "A valid site name of an existing website."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new collection within a site."
        }
      ]
    }
  ],
  "bundled": true
}